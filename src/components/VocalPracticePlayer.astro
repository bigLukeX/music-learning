---
const startNotes = [
  [45, 'A2'],
  [46, 'B♭2'],
  [47, 'B2'],
  [48, 'C3'],
  [50, 'D3'],
  [52, 'E3'],
  [53, 'F3'],
  [55, 'G3'],
  [57, 'A3'],
  [59, 'B3'],
  [60, 'C4'],
];

const ceilingNotes = [
  [60, 'C4'],
  [62, 'D4'],
  [64, 'E4'],
  [65, 'F4'],
  [67, 'G4'],
  [69, 'A4'],
];
---

<vocal-practice-player>
  <section class="vocal-player" aria-labelledby="vocal-player-title">
    <div class="vocal-player__heading">
      <span>浏览器自动钢琴</span>
      <h2 id="vocal-player-title">选好上下限，按一次开始</h2>
      <p>钢琴会先倒数，再逐个音带唱并自动半音移调；“听唱回声”会先示范、留空给你唱，最后再核对。</p>
    </div>

    <div class="vocal-player__controls">
      <label>
        <span>跟练套餐</span>
        <select data-routine>
          <option value="daily20" selected>常规练声 · 约 20 分钟</option>
          <option value="gentle">轻柔恢复 · 约 8 分钟</option>
          <option value="head">专项 · 头声与换区 10 分钟</option>
          <option value="mix">专项 · 混声与闭合 10 分钟</option>
          <option value="vowels">专项 · 元音统一 10 分钟</option>
          <option value="agility">专项 · 转音与灵活性 10 分钟</option>
          <option value="ear">听唱回声 · 约 6 分钟</option>
        </select>
        <small>声音正常选“常规20”；疲劳但说话正常选“轻柔”；专项只在常规后轮换。</small>
      </label>

      <label>
        <span>器材版本</span>
        <select data-sovt-tool>
          <option value="bottle" selected>有练声瓶</option>
          <option value="no-bottle">无练声瓶 · 唇颤音 / vv</option>
        </select>
        <small>有设备且按说明装好就选有瓶；没带设备直接选无瓶。</small>
      </label>

      <label>
        <span>舒适起音</span>
        <select data-start-note>
          {startNotes.map(([midi, label]) => <option value={midi} selected={midi === 48}>{label}</option>)}
        </select>
        <small>选能用小音量轻哼 3 次、既不压低也不抬高的音；不确定先试听 C3。</small>
      </label>

      <label>
        <span>最高音天花板</span>
        <select data-ceiling-note>
          {ceilingNotes.map(([midi, label]) => <option value={midi} selected={midi === 64}>{label}</option>)}
        </select>
        <small>选能稳定重复的最高音，不选偶尔碰到的最高音；当前先从 E4 开始。</small>
      </label>

      <label>
        <span>速度</span>
        <select data-bpm>
          <option value="60">60 BPM · 更从容</option>
          <option value="72" selected>72 BPM · 默认</option>
          <option value="84">84 BPM · 已熟悉</option>
        </select>
        <small>新音型或状态一般用60；正常用72；84只给已经唱清楚的转音。</small>
      </label>
    </div>

    <div class="vocal-player__actions">
      <button type="button" data-play>开始自动跟练</button>
      <button type="button" data-stop disabled>停止</button>
      <button type="button" data-preview-start>试听起音</button>
      <button type="button" data-preview-ceiling>试听天花板</button>
    </div>

    <div class="vocal-player__status" aria-live="polite">
      <div>
        <span>当前环节</span>
        <strong data-section>等待开始</strong>
      </div>
      <div>
        <span>发声音节</span>
        <strong data-cue>—</strong>
      </div>
      <div>
        <span>当前音</span>
        <strong data-note>—</strong>
      </div>
    </div>

    <div class="vocal-player__degrees" data-degrees aria-label="当前音型"></div>
    <progress data-progress max="100" value="0">0%</progress>
    <p class="vocal-player__message" data-message>默认从 C3 开始、以 E4 为天花板；这只是保守工作设置，不代表你的音域结论。</p>

    <noscript>需要启用 JavaScript 才能播放自动钢琴；页面下方的文字流程仍可照常使用。</noscript>
  </section>
</vocal-practice-player>

<script>
  const DEGREE_NAMES = new Map([
    [0, '1'],
    [2, '2'],
    [4, '3'],
    [5, '4'],
    [7, '5'],
    [9, '6'],
    [11, '7'],
    [12, '8'],
  ]);

  const NOTE_NAMES = ['C', 'C♯/D♭', 'D', 'D♯/E♭', 'E', 'F', 'F♯/G♭', 'G', 'G♯/A♭', 'A', 'A♯/B♭', 'B'];

  const ROUTINES = {
    daily20: [
      { title: '气流与轻起音', cue: '{sovt}', pattern: [0, 2, 4, 2, 0], span: 6 },
      { title: '哼鸣与连续音高', cue: 'mm（闭嘴“嗯”）或 ng（sing 尾音）', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 6 },
      { title: '元音链', cue: 'i衣 → e诶 → a啊 → o哦 → u乌', pattern: [0, 0, 0, 0, 0], span: 4 },
      { title: '头声与换区', cue: 'wu（轻“呜”）滑音：钢琴给起点、终点、返回', pattern: [0, 7, 0], span: 7 },
      { title: '混声与闭合', cue: 'mum（轻“马姆”）', pattern: [0, 4, 7, 4, 0], span: 6 },
      { title: '转音与灵活性', cue: 'da（轻“哒”）', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 5 },
      { title: '短旋律听唱', cue: '先听，再用 lu（轻“噜/卢”）回唱', pattern: [0, 2, 4, 2, 0], span: 2, echo: true },
    ],
    gentle: [
      { title: '轻声哼鸣三音', cue: 'mm（闭嘴“嗯”）或 ng（sing 尾音）', pattern: [0, 2, 4, 2, 0], span: 6 },
      { title: '半闭合五音', cue: '{sovt}', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 7 },
      { title: '轻声琶音', cue: 'wu（轻“呜”）', pattern: [0, 4, 7, 4, 0], span: 5 },
    ],
    head: [
      { title: '半闭合连接', cue: '{sovt}', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 6 },
      { title: '头声滑音', cue: 'wu（轻“呜”）滑音：钢琴给起点、终点、返回', pattern: [0, 7, 0], span: 8 },
      { title: '头声落回中区', cue: 'ng（sing 尾音）→ u（乌）', pattern: [0, 4, 7, 4, 0], span: 6 },
    ],
    mix: [
      { title: '半闭合预备', cue: '{sovt}', pattern: [0, 2, 4, 2, 0], span: 5 },
      { title: '轻闭合琶音', cue: 'mum（轻“马姆”）', pattern: [0, 4, 7, 4, 0], span: 7 },
      { title: '换区五音', cue: 'gug（短“格-啊-格”）', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 6 },
    ],
    vowels: [
      { title: '同音高元音链', cue: 'i衣 → e诶 → a啊 → o哦 → u乌', pattern: [0, 0, 0, 0, 0], span: 4 },
      { title: '元音 i', cue: 'i', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 2 },
      { title: '元音 e', cue: 'e', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 2 },
      { title: '元音 a', cue: 'a', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 2 },
      { title: '元音 o', cue: 'o', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 2 },
      { title: '元音 u', cue: 'u', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 2 },
    ],
    agility: [
      { title: '五音均匀度', cue: 'da（轻“哒”）', pattern: [0, 2, 4, 5, 7, 5, 4, 2, 0], span: 5 },
      { title: '琶音换音', cue: 'ya（轻“呀”）', pattern: [0, 4, 7, 4, 0], span: 5 },
      { title: '八度音阶', cue: 'da（轻“哒”）', pattern: [0, 2, 4, 5, 7, 9, 11, 12, 11, 9, 7, 5, 4, 2, 0], span: 2 },
      { title: '短旋律回声', cue: 'lu（轻“噜/卢”）', pattern: [0, 2, 4, 2, 0], span: 2, echo: true },
    ],
    ear: [
      { title: '二度回声', cue: 'lu（轻“噜/卢”）', pattern: [0, 2, 0], span: 3, echo: true },
      { title: '三度回声', cue: 'lu（轻“噜/卢”）', pattern: [0, 4, 0], span: 3, echo: true },
      { title: '五度回声', cue: 'lu（轻“噜/卢”）', pattern: [0, 7, 0], span: 3, echo: true },
      { title: '短旋律回声', cue: 'lu（轻“噜/卢”）', pattern: [0, 2, 4, 2, 0], span: 2, echo: true },
    ],
  };

  class VocalPracticePlayer extends HTMLElement {
    constructor() {
      super();
      this.audioContext = null;
      this.masterGain = null;
      this.activeSources = new Set();
      this.runToken = 0;
      this.completedSteps = 0;
      this.totalSteps = 1;
    }

    connectedCallback() {
      this.routineSelect = this.querySelector('[data-routine]');
      this.sovtSelect = this.querySelector('[data-sovt-tool]');
      this.startSelect = this.querySelector('[data-start-note]');
      this.ceilingSelect = this.querySelector('[data-ceiling-note]');
      this.bpmSelect = this.querySelector('[data-bpm]');
      this.playButton = this.querySelector('[data-play]');
      this.stopButton = this.querySelector('[data-stop]');
      this.previewStartButton = this.querySelector('[data-preview-start]');
      this.previewCeilingButton = this.querySelector('[data-preview-ceiling]');
      this.sectionOutput = this.querySelector('[data-section]');
      this.cueOutput = this.querySelector('[data-cue]');
      this.noteOutput = this.querySelector('[data-note]');
      this.degreeList = this.querySelector('[data-degrees]');
      this.progress = this.querySelector('[data-progress]');
      this.message = this.querySelector('[data-message]');

      this.playButton?.addEventListener('click', () => this.start());
      this.stopButton?.addEventListener('click', () => this.stop('已停止。下次从舒适音重新开始，不需要补做。'));
      this.previewStartButton?.addEventListener('click', () => this.previewPitch('start'));
      this.previewCeilingButton?.addEventListener('click', () => this.previewPitch('ceiling'));
      this.routineSelect?.addEventListener('change', () => this.previewRoutine());
      this.sovtSelect?.addEventListener('change', () => this.previewRoutine());
      this.startSelect?.addEventListener('change', () => this.previewRoutine());
      this.ceilingSelect?.addEventListener('change', () => this.previewRoutine());
      this.previewRoutine();
    }

    disconnectedCallback() {
      this.stop('');
    }

    noteName(midi) {
      const octave = Math.floor(midi / 12) - 1;
      return `${NOTE_NAMES[midi % 12]}${octave}`;
    }

    frequency(midi) {
      return 440 * Math.pow(2, (midi - 69) / 12);
    }

    getSettings() {
      return {
        routine: this.routineSelect?.value || 'daily20',
        sovt: this.sovtSelect?.value || 'bottle',
        start: Number(this.startSelect?.value || 48),
        ceiling: Number(this.ceilingSelect?.value || 64),
        bpm: Number(this.bpmSelect?.value || 72),
      };
    }

    rootsFor(section, start, ceiling) {
      const maxInterval = Math.max(...section.pattern);
      const available = ceiling - start - maxInterval;
      if (available < 0) return [];
      const topShift = Math.min(section.span, available);
      const up = Array.from({ length: topShift + 1 }, (_, index) => index);
      return up.length > 1 ? [...up, ...up.slice(0, -1).reverse()] : up;
    }

    cueFor(section, sovt) {
      const toolCue = sovt === 'bottle' ? '练声瓶' : '唇颤音；做不到时改 vv（有声 v，像 very 开头）';
      return section.cue.replace('{sovt}', toolCue);
    }

    previewRoutine() {
      const { routine, start, ceiling } = this.getSettings();
      const sections = ROUTINES[routine] || ROUTINES.daily20;
      const invalid = sections.some((section) => this.rootsFor(section, start, ceiling).length === 0);
      if (invalid) {
        this.message.textContent = '起音太高或天花板太低：请降低舒适起音，或选择更高的天花板。';
        this.playButton.disabled = true;
        return;
      }
      this.playButton.disabled = false;
      this.message.textContent = `当前范围：${this.noteName(start)} 起，最高不超过 ${this.noteName(ceiling)}。天花板是停止线，不是必须达到的目标。`;
    }

    async ensureAudio() {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) throw new Error('当前浏览器不支持 Web Audio。');
      if (!this.audioContext || this.audioContext.state === 'closed') {
        this.audioContext = new AudioContextClass();
        this.masterGain = this.audioContext.createGain();
        this.masterGain.gain.value = 0.72;
        this.masterGain.connect(this.audioContext.destination);
      }
      if (this.audioContext.state === 'suspended') await this.audioContext.resume();
    }

    async previewPitch(kind) {
      this.stop('');
      try {
        await this.ensureAudio();
      } catch (error) {
        this.message.textContent = error instanceof Error ? error.message : '无法启动音频。';
        return;
      }
      const settings = this.getSettings();
      const midi = kind === 'ceiling' ? settings.ceiling : settings.start;
      this.sectionOutput.textContent = kind === 'ceiling' ? '试听天花板' : '试听起音';
      this.cueOutput.textContent = '只轻哼一次，不做能力测试';
      this.noteOutput.textContent = this.noteName(midi);
      this.setDegrees([0], 0);
      this.schedulePiano(midi, 1.15, 0.17);
      this.message.textContent = kind === 'ceiling'
        ? '天花板应当能用中小音量稳定重复，而不是偶尔碰到。需要加音量或抬下巴，就把天花板降低。'
        : '起音应当接近舒适说话区：既不压低，也不需要抬高或变大声。';
      window.setTimeout(() => this.setDegrees([0]), 1200);
    }

    schedulePiano(midi, durationSeconds, volume = 0.2) {
      const context = this.audioContext;
      if (!context || !this.masterGain) return;
      const now = context.currentTime + 0.01;
      const gain = context.createGain();
      const fundamental = context.createOscillator();
      const harmonic = context.createOscillator();
      const harmonicGain = context.createGain();

      fundamental.type = 'triangle';
      fundamental.frequency.value = this.frequency(midi);
      harmonic.type = 'sine';
      harmonic.frequency.value = this.frequency(midi) * 2;
      harmonicGain.gain.value = 0.17;

      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(volume, now + 0.018);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + durationSeconds);

      fundamental.connect(gain);
      harmonic.connect(harmonicGain);
      harmonicGain.connect(gain);
      gain.connect(this.masterGain);

      const sources = [fundamental, harmonic];
      sources.forEach((source) => {
        this.activeSources.add(source);
        source.start(now);
        source.stop(now + durationSeconds + 0.03);
        source.addEventListener('ended', () => this.activeSources.delete(source), { once: true });
      });
    }

    scheduleClick(accent = false) {
      const context = this.audioContext;
      if (!context || !this.masterGain) return;
      const now = context.currentTime + 0.01;
      const oscillator = context.createOscillator();
      const gain = context.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.value = accent ? 1320 : 920;
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(accent ? 0.12 : 0.075, now + 0.005);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.055);
      oscillator.connect(gain);
      gain.connect(this.masterGain);
      this.activeSources.add(oscillator);
      oscillator.start(now);
      oscillator.stop(now + 0.06);
      oscillator.addEventListener('ended', () => this.activeSources.delete(oscillator), { once: true });
    }

    wait(milliseconds) {
      return new Promise((resolve) => window.setTimeout(resolve, milliseconds));
    }

    setDegrees(pattern, activeIndex = -1, hide = false) {
      if (!this.degreeList) return;
      this.degreeList.replaceChildren();
      pattern.forEach((interval, index) => {
        const item = document.createElement('span');
        item.textContent = hide ? '•' : (DEGREE_NAMES.get(interval) || `+${interval}`);
        if (index === activeIndex) item.classList.add('is-active');
        this.degreeList.append(item);
      });
    }

    updateProgress() {
      const percent = Math.round((this.completedSteps / Math.max(this.totalSteps, 1)) * 100);
      this.progress.value = percent;
      this.progress.textContent = `${percent}%`;
    }

    async countIn(beatMs, token) {
      for (let count = 0; count < 2; count += 1) {
        if (token !== this.runToken) return false;
        this.noteOutput.textContent = count === 0 ? '准备' : '吸气';
        this.scheduleClick(count === 0);
        await this.wait(beatMs);
      }
      return token === this.runToken;
    }

    async playPattern(section, rootMidi, beatMs, token, hideDegrees = false) {
      this.setDegrees(section.pattern, -1, hideDegrees);
      for (let index = 0; index < section.pattern.length; index += 1) {
        if (token !== this.runToken) return false;
        const midi = rootMidi + section.pattern[index];
        this.noteOutput.textContent = `${this.noteName(midi)} · 音级 ${DEGREE_NAMES.get(section.pattern[index]) || '—'}`;
        this.setDegrees(section.pattern, index, hideDegrees);
        this.schedulePiano(midi, beatMs * 0.82 / 1000);
        await this.wait(beatMs);
      }
      this.setDegrees(section.pattern, -1, hideDegrees);
      return token === this.runToken;
    }

    async responseWindow(section, rootMidi, beatMs, token) {
      this.setDegrees(section.pattern, -1, true);
      for (let index = 0; index < section.pattern.length; index += 1) {
        if (token !== this.runToken) return false;
        this.noteOutput.textContent = index === 0 ? `${this.noteName(rootMidi)} · 从这里回唱` : `回唱第 ${index + 1} 音`;
        if (index === 0) this.schedulePiano(rootMidi, beatMs * 0.72 / 1000, 0.14);
        else this.scheduleClick(index % 4 === 0);
        await this.wait(beatMs);
      }
      return token === this.runToken;
    }

    async start() {
      this.stop('');
      const token = this.runToken;
      const settings = this.getSettings();
      const sections = ROUTINES[settings.routine] || ROUTINES.daily20;
      const rootsBySection = sections.map((section) => this.rootsFor(section, settings.start, settings.ceiling));

      if (rootsBySection.some((roots) => roots.length === 0)) {
        this.previewRoutine();
        return;
      }

      try {
        await this.ensureAudio();
      } catch (error) {
        this.message.textContent = error instanceof Error ? error.message : '无法启动音频。';
        return;
      }

      this.playButton.disabled = true;
      this.stopButton.disabled = false;
      this.completedSteps = 0;
      this.totalSteps = rootsBySection.reduce((sum, roots) => sum + roots.length, 0);
      this.updateProgress();
      const beatMs = 60000 / settings.bpm;

      for (let sectionIndex = 0; sectionIndex < sections.length; sectionIndex += 1) {
        const section = sections[sectionIndex];
        const rootOffsets = rootsBySection[sectionIndex];
        const cue = this.cueFor(section, settings.sovt);
        this.sectionOutput.textContent = `${sectionIndex + 1}/${sections.length} · ${section.title}`;
        this.cueOutput.textContent = cue;

        for (const offset of rootOffsets) {
          if (token !== this.runToken) return;
          const rootMidi = settings.start + offset;
          this.message.textContent = section.echo
            ? `先听钢琴示范，再在留空阶段从 ${this.noteName(rootMidi)} 回唱。`
            : `跟着钢琴用「${cue}」轻声唱；根音 ${this.noteName(rootMidi)}。`;

          if (!(await this.countIn(beatMs, token))) return;

          if (section.echo) {
            this.sectionOutput.textContent = `${sectionIndex + 1}/${sections.length} · 先听`;
            if (!(await this.playPattern(section, rootMidi, beatMs, token))) return;
            await this.wait(beatMs);
            if (token !== this.runToken) return;
            this.sectionOutput.textContent = `${sectionIndex + 1}/${sections.length} · 轮到你`;
            if (!(await this.responseWindow(section, rootMidi, beatMs, token))) return;
            await this.wait(beatMs);
            if (token !== this.runToken) return;
            this.sectionOutput.textContent = `${sectionIndex + 1}/${sections.length} · 核对`;
            if (!(await this.playPattern(section, rootMidi, beatMs, token))) return;
          } else if (!(await this.playPattern(section, rootMidi, beatMs, token))) {
            return;
          }

          this.completedSteps += 1;
          this.updateProgress();
          await this.wait(beatMs);
        }
      }

      if (token !== this.runToken) return;
      this.sectionOutput.textContent = '完成';
      this.cueOutput.textContent = '正常说一句话并复查';
      this.noteOutput.textContent = '—';
      this.setDegrees([]);
      this.message.textContent = '结束后声音应与开始前相同或更轻松。若更沙、更紧或说话费力，下次降低音高、音量或缩短时长。';
      this.playButton.disabled = false;
      this.stopButton.disabled = true;
    }

    stop(message) {
      this.runToken += 1;
      this.activeSources.forEach((source) => {
        try { source.stop(); } catch {}
      });
      this.activeSources.clear();
      if (this.playButton) this.playButton.disabled = false;
      if (this.stopButton) this.stopButton.disabled = true;
      if (message && this.message) this.message.textContent = message;
    }
  }

  if (!customElements.get('vocal-practice-player')) {
    customElements.define('vocal-practice-player', VocalPracticePlayer);
  }
</script>

<style>
  .vocal-player {
