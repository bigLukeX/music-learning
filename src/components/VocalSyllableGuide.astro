---
interface Props { mode?: 'syllables' | 'english'; }
const { mode = 'syllables' } = Astro.props;
const syllables = [
  {
    code: 'mm / mmm',
    chinese: '闭嘴轻哼“嗯——”',
    action: '双唇轻闭，牙齿和下巴别咬紧；声音连续，不追求鼻子震得大。',
    use: '轻起音、哼鸣、音高连续',
    speech: 'mmm',
    listen: '听 mmm',
  },
  {
    code: 'ng',
    chinese: '英文 sing 的最后一个音',
    action: '先说 sing，再停在尾部 /ŋ/；舌后部抬起，嘴可以微张，不要继续加“嗯”的元音。',
    use: '头声入口、换区、从哼鸣过渡到元音',
    speech: 'sing',
    listen: '听 sing 尾音',
  },
  {
    code: 'wu / woo',
    chinese: '接近“呜——”',
    action: '嘴唇圆而松，像轻声说“呜”；不要噘得很硬，也不要吹出大量气。',
    use: '头声、滑音、小音量',
    speech: 'woo',
    listen: '听 woo',
  },
  {
    code: 'mum',
    chinese: '英语 mum：轻 m 接元音，再收 m',
    action: '两端的 m 轻轻闭唇，中间取英语 mum 的元音音色；练长音时延长中间元音，最后才轻收 m，不唱成夸张张口的“妈”。',
    use: '轻闭合、混声连接、琶音',
    speech: 'mum',
    listen: '听 mum',
  },
  {
    code: 'gug',
    chinese: '硬 g 接短“啊”音色再收 g，合成一音节',
    action: '两个 g 都短而轻，元音承担时值；不要拆成三个汉字音节，不用舌根和喉咙猛撞。',
    use: '清楚起音、混声与换区五音',
    speech: 'gug',
    listen: '听 gug',
  },
  {
    code: 'vv',
    chinese: '英文 very 开头的有声 v',
    action: '上牙轻碰下唇，持续发带振动的 v；手摸喉部应有轻振动，别发成无声的 f。',
    use: '无练声瓶时的半闭合替代',
    speech: 'very',
    listen: '听 very 开头',
  },
  {
    code: 'zz', chinese: '英语 zoo 开头的有声 z',
    action: '舌尖靠近上齿龈，留细小气流缝隙并发声；保持 z，不加“滋”的元音，也不咬牙。',
    use: '四拍连续发声；与 vv 二选一', speech: 'zoo', listen: '听 zoo 开头',
  },
  {
    code: 'noo', chinese: '轻“努”，延长乌的元音',
    action: 'n 在音头轻触，随后张开通向 u；不逐音用下巴点头。',
    use: '轻起音短型', speech: 'noo', listen: '听 noo',
  },
  {
    code: 'vee', chinese: '有声 v 接“衣”',
    action: '先用上牙轻碰下唇发 v，再接 i；开头不是汉语的 w。',
    use: '从 vv 迁移到元音', speech: 'vee', listen: '听 vee',
  },
  {
    code: 'no', chinese: '英语 no，轻“挪”',
    action: 'n 轻而短，后面由 o 的元音承担时值；不模仿汉语声调升降。',
    use: '轻起音的备选音节', speech: 'no', listen: '听 no',
  },
  {
    code: 'gee（硬 g） / ghee', chinese: '硬 g 接“衣”',
    action: '舌后部轻触后马上放开接 i；这里取英语 ghee 的硬 g，不读字母 G；做起来费力就用 mum。',
    use: '轻起音备选，不额外撞击舌根', speech: 'ghee', listen: '听 ghee',
  },
  {
    code: 'da / dah',
    chinese: '轻声“哒”',
    action: '舌尖轻碰上齿龈后立刻离开；每个音分开但不断气，不要用下巴逐音点头。',
    use: '转音、五音均匀度、八度音阶',
    speech: 'dah',
    listen: '听 dah',
  },
  {
    code: 'ya / yah',
    chinese: '轻声“呀”',
    action: '开头 y 很短，后面的元音承担时值；不要把每个音都咬成很重的“伊呀”。',
    use: '琶音换音、连贯性',
    speech: 'yah',
    listen: '听 yah',
  },
  {
    code: 'lu / loo',
    chinese: '接近“噜/卢”',
    action: 'l 只在音头轻触一次，后面的 u/oo 承担音高；回唱时先想好目标音再开口。',
    use: '听唱回声、旋律记忆',
    speech: 'loo',
    listen: '听 loo',
  },
  {
    code: 'i–e–a–o–u',
    chinese: '衣—诶—啊—哦—乌',
    action: '先在同一音高慢慢换元音；音量和音高尽量不变，不追求夸张口型。',
    use: '元音统一、音准和声道调整',
    speech: 'ee, eh, ah, oh, oo',
    listen: '听元音顺序',
  },
];
const sentences = [
  { code: 'Take a little time with me.', chinese: '和我一起慢一点，留一点时间。',
    action: '先听整句读法，再按正文的八分网格安排音节；说话示意没有锁定节拍器速度。',
    use: '重读骨架与 time 的双元音', speech: 'Take a little time with me.', listen: '听第一句读法' },
  { code: 'Let the morning carry you.', chinese: '让清晨带着你前行。',
    action: '听 morning、carry 的第一音节，再回到节奏表；不把每个音节都说成一样重。',
    use: '词内重音和弱读 the', speech: 'Let the morning carry you.', listen: '听第二句读法' },
];
const items = mode === 'english' ? sentences : syllables;
---

<vocal-syllable-guide id={mode === 'english' ? 'english-reading' : 'syllables'}>
  <section class="syllable-guide" aria-labelledby={`syllable-guide-title-${mode}`}>
    <div class="syllable-guide__heading">
      <span>{mode === 'english' ? '原创句子的读法参考' : '先听发音，再跟钢琴'}</span>
      <h2 id={`syllable-guide-title-${mode}`}>{mode === 'english' ? '试听句子读法' : '练声音节字典'}</h2>
      <p>点击播放浏览器的慢速读法示意；不同设备声音可能不同。这不是真人范唱，也不示范声乐动作或固定歌曲节奏。</p>
    </div>

    <div class="syllable-guide__grid">
      {items.map((item) => (
        <article>
          <div class="syllable-guide__name">
            <code>{item.code}</code>
            <strong>{item.chinese}</strong>
          </div>
          <p>{item.action}</p>
          <small>用途：{item.use}</small>
          <button type="button" data-speech={item.speech} data-label={item.code}>{item.listen}</button>
        </article>
      ))}
    </div>

    <p class="syllable-guide__status" data-speech-status aria-live="polite">选择一项试听；浏览器声音只负责示意读法。</p>
  </section>
</vocal-syllable-guide>

<script>
  class VocalSyllableGuide extends HTMLElement {
    connectedCallback() {
      this.status = this.querySelector('[data-speech-status]');
      this.querySelectorAll('[data-speech]').forEach((button) => {
        button.addEventListener('click', () => this.speak(button));
      });
    }

    disconnectedCallback() {
      this.speechToken = (this.speechToken || 0) + 1;
      if ('speechSynthesis' in window) window.speechSynthesis.cancel();
    }

    speak(button) {
      if (!('speechSynthesis' in window) || !('SpeechSynthesisUtterance' in window)) {
        this.status.textContent = '当前浏览器不支持语音播放；请参考卡片与正文的读法说明。';
        return;
      }

      const token = this.speechToken = (this.speechToken || 0) + 1;
      const text = button.dataset.speech;
      const label = button.dataset.label;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'en-US';
      utterance.rate = 0.62;
      utterance.pitch = 1;
      const voices = window.speechSynthesis.getVoices();
      const voice = voices.find((candidate) => candidate.lang?.toLowerCase() === 'en-us')
        || voices.find((candidate) => candidate.lang?.toLowerCase().startsWith('en'));
      if (voice) utterance.voice = voice;
      utterance.addEventListener('start', () => {
        if (token !== this.speechToken) return;
        this.status.textContent = `正在播放 ${label} 的发音示意。`;
      });
      utterance.addEventListener('end', () => {
        if (token !== this.speechToken) return;
        this.status.textContent = `已播放 ${label}。按正文继续练习；只参考读法，不模仿合成语音的音色。`;
      });
      utterance.addEventListener('error', () => {
        if (token !== this.speechToken) return;
        this.status.textContent = '语音播放失败；请参考卡片与正文，或用已有词典核对读音。';
      });
      window.speechSynthesis.speak(utterance);
    }
  }

  if (!customElements.get('vocal-syllable-guide')) {
    customElements.define('vocal-syllable-guide', VocalSyllableGuide);
  }
</script>

<style>
  .syllable-guide {
    margin: 1.5rem 0 2rem;
  }

  .syllable-guide__heading > span {
    display: inline-flex;
    padding: 0.24rem 0.58rem;
    border-radius: 999px;
    color: color-mix(in srgb, var(--music-rust) 78%, currentColor);
    background: color-mix(in srgb, var(--music-gold) 17%, transparent);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .syllable-guide__heading h2 {
    margin: 0.7rem 0 0.45rem;
  }

  .syllable-guide__heading p {
    margin: 0;
    color: var(--sl-color-gray-2);
  }

  .syllable-guide__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 1rem;
  }

  .syllable-guide article {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    padding: 0.9rem;
    border: 1px solid color-mix(in srgb, var(--music-gold) 30%, transparent);
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--music-gold) 5%, var(--sl-color-bg));
  }

  .syllable-guide__name {
    display: grid;
    gap: 0.25rem;
  }

  .syllable-guide__name code {
    width: fit-content;
    font-size: 1rem;
  }

  .syllable-guide article p,
  .syllable-guide article small {
    margin: 0;
  }

  .syllable-guide article small {
    color: var(--sl-color-gray-2);
  }

  .syllable-guide button {
    justify-self: start;
    min-height: 2.3rem;
    margin-top: 0.15rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--music-teal) 45%, transparent);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--music-teal) 12%, var(--sl-color-bg));
    color: inherit;
    font: inherit;
    font-weight: 750;
    cursor: pointer;
  }

  .syllable-guide__status {
    margin-bottom: 0;
    color: var(--sl-color-gray-2);
  }

  @media (max-width: 42rem) {
    .syllable-guide__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
