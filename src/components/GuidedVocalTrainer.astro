      { id:'foundation-mum', title:'mum · 轻起音三音', focus:'音头和音高一起出现，不漏气也不猛撞', cue:'mum（轻“马姆”）', label:'1–2–3–2–1 × 4', type:'scale', pattern:[0,2,4,2,0], bpm:60, span:0, direction:'up', repeats:4, repeatGap:5, prep:6, response:3, post:6, demo:true },
      { id:'foundation-vowels', title:'同音高 · 五元音链', focus:'换元音时音高和音量尽量不变', cue:'衣—诶—啊—哦—乌', label:'i–e–a–o–u × 4', type:'scale', pattern:[0,0,0,0,0], bpm:60, span:0, direction:'up', repeats:4, repeatGap:5, prep:6, response:3, post:6, demo:true },
      { id:'foundation-lyric', title:'一句歌词 · 三层迁移', focus:'把舒服的发声接回真实文字', cue:'选3–5秒舒适歌词', label:'说节奏 → 元音 → 原词', type:'manual', prep:8, post:8, phases:[['只说节奏 · 第1遍',6],['只说节奏 · 第2遍',6],['休息',10],['只唱元音 · 第1遍',6],['只唱元音 · 第2遍',6],['休息',10],['原词 · 第1遍',6],['休息',10],['原词 · 第2遍',6]] },
    ],
    daily: [
      { id:'daily-sovt', title:'半闭合热身 · 五音', focus:'有瓶用轻气泡+声；无瓶用唇颤或vv', cue:'练声瓶 / 唇颤 / vv', label:'1–2–3–2–1', type:'scale', pattern:[0,2,4,2,0], bpm:60, span:4, direction:'updown', prep:8, gap:2, response:3, post:6, demo:true },
      { id:'daily-hum', title:'mm / ng · 九音连贯', focus:'保持声音连续，不用鼻腔震动大小判断对错', cue:'mm 或 ng', label:'1–2–3–4–5–4–3–2–1', type:'scale', pattern:[0,2,4,5,7,5,4,2,0], bpm:60, span:3, direction:'updown', prep:6, gap:2, response:3, post:6, demo:true },
      { id:'daily-vowels', title:'元音统一 · 同音链', focus:'在同一音高换元音，口型变化但别把音高带跑', cue:'衣—诶—啊—哦—乌', label:'i–e–a–o–u × 4', type:'scale', pattern:[0,0,0,0,0], bpm:60, span:0, direction:'up', repeats:4, repeatGap:4, prep:6, response:3, post:6, demo:true },
      { id:'daily-glide', title:'轻 wu · 五度滑音', focus:'连续滑过去，不唱成离散台阶', cue:'wu（轻“呜”）', label:'1～～5～～1', type:'glide', interval:7, glideBeats:6, bpm:60, span:4, direction:'updown', prep:6, gap:2, response:3, post:6, demo:true },
      { id:'daily-mum', title:'mum · 琶音连接', focus:'跨更宽音程仍保持轻起音', cue:'mum（轻“马姆”）', label:'1–3–5–3–1', type:'scale', pattern:[0,4,7,4,0], bpm:60, span:4, direction:'updown', prep:6, gap:2, response:3, post:6, demo:true },
      { id:'daily-agility', title:'da · 五音灵活性', focus:'每个音清楚、均匀，不用下巴逐音点', cue:'da（轻“哒”）', label:'1–2–3–4–5–4–3–2–1', type:'scale', pattern:[0,2,4,5,7,5,4,2,0], bpm:72, span:3, direction:'updown', prep:6, gap:2, response:3, post:6, demo:true },
      { id:'daily-octave', title:'da · 八度音阶', focus:'先逐音准确，再谈速度；范围不够就不做这条', cue:'da（轻“哒”）', label:'1–2–3–4–5–6–7–8–7–6–5–4–3–2–1', type:'scale', pattern:[0,2,4,5,7,9,11,12,11,9,7,5,4,2,0], bpm:60, span:1, direction:'updown', prep:8, gap:3, response:3, post:8, demo:true },
