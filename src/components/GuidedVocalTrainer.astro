  class GuidedVocalTrainer extends HTMLElement {
    connectedCallback() {
      if (this.initialized) return;
      this.initialized = true;
      this.routine = this.dataset.routine || 'high';
      this.rootSelect = this.querySelector('[data-root]');
      this.bpmSelect = this.querySelector('[data-bpm]');
      this.startButton = this.querySelector('[data-start]');
      this.stopButton = this.querySelector('[data-stop]');
      this.previewButton = this.querySelector('[data-preview]');
      this.stepOutput = this.querySelector('[data-step]');
      this.instructionOutput = this.querySelector('[data-instruction]');
      this.patternOutput = this.querySelector('[data-pattern]');
      this.timerOutput = this.querySelector('[data-timer]');
      this.progress = this.querySelector('[data-progress]');
      this.noteOutput = this.querySelector('[data-note]');
      this.choices = this.querySelector('[data-choices]');
      this.checkText = this.querySelector('[data-check-text]');
      this.runToken = 0;
      this.activeSources = new Set();
      this.isRunning = false;
      this.choiceResolver = null;

      this.startButton.addEventListener('click', () => this.start());
      this.stopButton.addEventListener('click', () => this.stop('已停止。下次从当前页面重新开始即可，不需要补做。'));
      this.previewButton.addEventListener('click', () => this.previewRoot());
      this.querySelectorAll('[data-choice]').forEach((button) => {
        button.addEventListener('click', () => this.choose(button.dataset.choice));
      });
      [this.rootSelect, this.bpmSelect].forEach((select) => {
        select.addEventListener('change', () => {
          if (this.isRunning) this.stop('设置已改变。按开始用新设置重新跟练。');
        });
      });
      this.syncButtons();
    }

    disconnectedCallback() {
      this.stop('');
    }

    noteName(midi) {
      const octave = Math.floor(midi / 12) - 1;
      return NOTE_NAMES[midi % 12] + octave;
    }

    frequency(midi) {
      return 440 * Math.pow(2, (midi - 69) / 12);
    }

    root() {
      return Number(this.rootSelect.value || 48);
    }

    bpm() {
      return Number(this.bpmSelect.value || 60);
    }

    beatMs() {
      return 60000 / this.bpm();
    }

    async ensureAudio() {
      const AudioContextClass = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextClass) throw new Error('当前浏览器不支持 Web Audio。');
      if (!this.audioContext || this.audioContext.state === 'closed') {
        this.audioContext = new AudioContextClass();
        this.masterGain = this.audioContext.createGain();
        this.masterGain.gain.value = 0.68;
        this.masterGain.connect(this.audioContext.destination);
      }
      if (this.audioContext.state === 'suspended') await this.audioContext.resume();
    }

    scheduleTone(midi, durationSeconds = 0.55, volume = 0.18) {
      if (!this.audioContext || !this.masterGain) return;
      const now = this.audioContext.currentTime + 0.01;
      const oscillator = this.audioContext.createOscillator();
      const gain = this.audioContext.createGain();
      oscillator.type = 'triangle';
      oscillator.frequency.value = this.frequency(midi);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(volume, now + 0.015);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + durationSeconds);
      oscillator.connect(gain);
      gain.connect(this.masterGain);
      this.activeSources.add(oscillator);
      oscillator.start(now);
      oscillator.stop(now + durationSeconds + 0.03);
      oscillator.addEventListener('ended', () => this.activeSources.delete(oscillator), { once: true });
    }

    scheduleClick(accent = false) {
      if (!this.audioContext || !this.masterGain) return;
      const now = this.audioContext.currentTime + 0.01;
      const oscillator = this.audioContext.createOscillator();
      const gain = this.audioContext.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.value = accent ? 1320 : 900;
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(accent ? 0.11 : 0.065, now + 0.005);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.055);
      oscillator.connect(gain);
      gain.connect(this.masterGain);
      this.activeSources.add(oscillator);
      oscillator.start(now);
      oscillator.stop(now + 0.06);
      oscillator.addEventListener('ended', () => this.activeSources.delete(oscillator), { once: true });
    }

    wait(ms) {
      return new Promise((resolve) => window.setTimeout(resolve, ms));
    }

    async waitSeconds(seconds, token, prefix) {
      for (let remaining = seconds; remaining > 0; remaining -= 1) {
        if (token !== this.runToken) return false;
        this.timerOutput.textContent = (prefix ? prefix + ' · ' : '') + remaining + ' 秒';
        await this.wait(1000);
      }
      this.timerOutput.textContent = '继续';
      return token === this.runToken;
    }

    async countIn(token, beats = 4) {
      for (let count = beats; count > 0; count -= 1) {
        if (token !== this.runToken) return false;
        this.timerOutput.textContent = '准备 ' + count;
        this.scheduleClick(count === beats);
        await this.wait(this.beatMs());
      }
      this.timerOutput.textContent = '现在';
      return token === this.runToken;
    }

    patternText(pattern) {
      return pattern.map((interval) => {
        if (interval === 0) return '1';
        if (interval === 2) return '2';
        if (interval === 4) return '3';
        if (interval === 5) return '4';
        if (interval === 7) return '5';
        return '+' + interval;
      }).join('  ');
    }

    async playPattern(pattern, token) {
      this.patternOutput.textContent = this.patternText(pattern);
      for (const interval of pattern) {
        if (token !== this.runToken) return false;
        const midi = this.root() + interval;
        this.timerOutput.textContent = this.noteName(midi);
        this.scheduleTone(midi, this.beatMs() * 0.8 / 1000);
        await this.wait(this.beatMs());
      }
      return token === this.runToken;
    }

    async runGrid(step, token, withTone) {
      if (!(await this.countIn(token, 4))) return false;
      const halfBeat = this.beatMs() / 2;
      for (let i = 0; i < step.grid.length; i += 1) {
        if (token !== this.runToken) return false;
        const tokenText = step.grid[i];
        this.patternOutput.textContent = tokenText;
        this.timerOutput.textContent = '第 ' + (Math.floor(i / 8) + 1) + ' 小节 · ' + ((i % 8) + 1) + '/8';
        this.scheduleClick(i % 2 === 0);
        if (withTone && tokenText !== '·' && tokenText !== '—') {
          this.scheduleTone(this.root() + (step.pattern?.[i] || 0), halfBeat * 0.78 / 1000, 0.12);
        }
        await this.wait(halfBeat);
      }
      this.patternOutput.textContent = '两小节结束';
      return token === this.runToken;
    }

    async runStep(step, token) {
      this.stepOutput.textContent = step.title || '继续';
      this.instructionOutput.textContent = step.text || '';
      this.patternOutput.textContent = step.pattern ? this.patternText(step.pattern) : '—';
      this.timerOutput.textContent = '—';

      if (step.type === 'message' || step.type === 'manual') {
        return await this.waitSeconds(step.seconds || 4, token, step.type === 'manual' ? '现在做' : '阅读');
      }

      if (step.type === 'rest') {
        return await this.waitSeconds(step.seconds || 5, token, '休息');
      }

      if (step.type === 'restBeats') {
        const beats = step.beats || 4;
        for (let i = beats; i > 0; i -= 1) {
          if (token !== this.runToken) return false;
          this.timerOutput.textContent = '休息 ' + i + ' 拍';
          this.scheduleClick(i === beats);
          await this.wait(this.beatMs());
        }
        return true;
      }

      if (step.type === 'listenRoot') {
        this.patternOutput.textContent = this.noteName(this.root());
        this.scheduleTone(this.root(), 1.1, 0.18);
        return await this.waitSeconds(2, token, '只听');
      }

      if (step.type === 'listen') {
        return await this.playPattern(step.pattern, token);
      }

      if (step.type === 'sing') {
        if (!(await this.countIn(token, 4))) return false;
        return await this.playPattern(step.pattern, token);
      }

      if (step.type === 'glide') {
        if (!(await this.countIn(token, 4))) return false;
        this.patternOutput.textContent = '1 ～～ 3 ～～ 1';
        this.timerOutput.textContent = '滑上去';
        this.scheduleTone(this.root(), 0.5, 0.13);
        await this.wait(this.beatMs() * 2);
        if (token !== this.runToken) return false;
        this.timerOutput.textContent = '滑回来';
        this.scheduleTone(this.root() + 4, 0.5, 0.13);
        await this.wait(this.beatMs() * 2);
        if (token !== this.runToken) return false;
        this.scheduleTone(this.root(), 0.5, 0.13);
        return true;
      }

      if (step.type === 'sustain' || step.type === 'decrescendo') {
        if (!(await this.countIn(token, 4))) return false;
        this.scheduleTone(this.root(), 0.65, 0.13);
        const beats = step.beats || 4;
        for (let i = 1; i <= beats; i += 1) {
          if (token !== this.runToken) return false;
          this.patternOutput.textContent = step.type === 'decrescendo' && i > 2 ? '稍微减弱' : '保持';
          this.timerOutput.textContent = i + ' / ' + beats + ' 拍';
          this.scheduleClick(i === 1);
          await this.wait(this.beatMs());
        }
        return true;
      }

      if (step.type === 'sustainSeconds') {
        if (!(await this.countIn(token, 4))) return false;
        this.scheduleTone(this.root(), 0.65, 0.13);
        return await this.waitSeconds(step.seconds || 5, token, '持续');
      }

      if (step.type === 'grid') {
        return await this.runGrid(step, token, false);
      }

      if (step.type === 'gridTone') {
        return await this.runGrid(step, token, true);
      }

      if (step.type === 'check') {
        this.checkText.textContent = step.text || '刚才这一组怎么样？';
        this.choices.hidden = false;
        this.timerOutput.textContent = '等你选择';
        const choice = await new Promise((resolve) => {
          this.choiceResolver = resolve;
        });
        this.choiceResolver = null;
        this.choices.hidden = true;
        if (token !== this.runToken || choice === 'stop') return { stop: true };
        if (choice === 'repeat') {
          if (step.lowerOnRepeat) this.lowerRootOneStep();
          return { restartAt: Number.isInteger(step.restartAt) ? step.restartAt : 0 };
        }
        return true;
      }

      return true;
    }

    lowerRootOneStep() {
      const options = Array.from(this.rootSelect.options);
      const index = options.findIndex((option) => option.value === this.rootSelect.value);
      if (index > 0) {
        this.rootSelect.value = options[index - 1].value;
        this.noteOutput.textContent = '已自动把起音降到 ' + options[index - 1].textContent + '；重做这一小组。';
      } else {
        this.noteOutput.textContent = '已经是列表最低起音。保持舒适，不再向下硬试；必要时今天停止。';
      }
    }

    choose(choice) {
      if (this.choiceResolver) this.choiceResolver(choice);
    }

    syncButtons() {
      this.startButton.disabled = this.isRunning;
      this.stopButton.disabled = !this.isRunning;
      this.previewButton.disabled = this.isRunning;
      this.rootSelect.disabled = this.isRunning;
      this.bpmSelect.disabled = this.isRunning;
    }

    updateProgress(index, total) {
      const percent = Math.round((index / Math.max(total, 1)) * 100);
      this.progress.value = percent;
      this.progress.textContent = percent + '%';
    }

    async previewRoot() {
      if (this.isRunning) return;
      try {
        await this.ensureAudio();
      } catch (error) {
        this.noteOutput.textContent = error instanceof Error ? error.message : '无法播放参考音。';
        return;
      }
      this.stepOutput.textContent = '试听起音';
      this.instructionOutput.textContent = '只轻哼一次。需要压低、抬高或变大声，就换一个更舒服的音。';
      this.patternOutput.textContent = this.noteName(this.root());
      this.scheduleTone(this.root(), 1.15, 0.17);
    }

    async start() {
      if (this.isRunning) return;
      this.stop('');
      const token = this.runToken;
      const steps = FLOWS[this.routine] || FLOWS.high;
      this.isRunning = true;
      this.syncButtons();
      this.progress.value = 0;
      this.noteOutput.textContent = '开始后只看上面的大字提示；不要一边唱一边读后面的理论正文。';

      try {
        await this.ensureAudio();
      } catch (error) {
        if (token === this.runToken) this.stop(error instanceof Error ? error.message : '无法启动音频。');
        return;
      }
      if (token !== this.runToken) return;

      for (let index = 0; index < steps.length; index += 1) {
        if (token !== this.runToken) return;
        this.updateProgress(index, steps.length);
        const result = await this.runStep(steps[index], token);
        if (token !== this.runToken) return;
        if (result && typeof result === 'object' && result.stop) {
          this.stop('已停止。声音不舒服时今天就到这里。');
          return;
        }
        if (result && typeof result === 'object' && Number.isInteger(result.restartAt)) {
          index = result.restartAt - 1;
        }
      }

      if (token !== this.runToken) return;
      this.updateProgress(steps.length, steps.length);
      this.stepOutput.textContent = '本次完成';
      this.instructionOutput.textContent = '正常说一句话，和练前比较。没有不适就结束，不追加练习凑时长。';
      this.patternOutput.textContent = '✓';
      this.timerOutput.textContent = '结束';
      this.noteOutput.textContent = '完成训练器只表示流程走完，不代表能力通关。下次同条件能复现，才算有效证据。';
      this.isRunning = false;
      this.syncButtons();
    }

    stop(message) {
      this.runToken += 1;
      this.activeSources.forEach((source) => {
        try { source.stop(); } catch {}
      });
      this.activeSources.clear();
      if (this.choiceResolver) {
        this.choiceResolver('stop');
        this.choiceResolver = null;
      }
      this.isRunning = false;
      if (this.choices) this.choices.hidden = true;
      if (this.initialized) this.syncButtons();
      if (message && this.noteOutput) {
        this.stepOutput.textContent = '已停止';
        this.instructionOutput.textContent = message;
        this.timerOutput.textContent = '—';
      }
    }
  }

  if (!customElements.get('guided-vocal-trainer')) {
    customElements.define('guided-vocal-trainer', GuidedVocalTrainer);
  }
</script>

