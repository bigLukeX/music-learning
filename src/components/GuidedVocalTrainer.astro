      { id:'high-wu-glide', title:'wu · 五度滑音', focus:'把声区连接做成一条线，不唱成台阶', cue:'wu（轻“呜”）', label:'1～～5～～1', type:'glide', interval:7, glideBeats:6, bpm:60, span:5, direction:'updown', prep:6, gap:2, response:3, post:6, demo:true },
      { id:'high-mum-13531', title:'mum · 混声琶音', focus:'跨更宽音程时仍保持轻起音和可重复', cue:'mum（轻“马姆”）', label:'1–3–5–3–1', type:'scale', pattern:[0,4,7,4,0], bpm:60, span:5, direction:'updown', prep:6, gap:2, response:3, post:6, demo:true },
      { id:'high-gug', title:'gug · 换区五音', focus:'音头清楚但不猛撞；高处不靠喊', cue:'gug（轻硬g）', label:'1–2–3–4–5–4–3–2–1', type:'scale', pattern:[0,2,4,5,7,5,4,2,0], bpm:60, span:4, direction:'updown', prep:8, gap:2, response:3, post:6, demo:true },
    ],
    soft: [
      { id:'soft-sustain', title:'轻元音 · 4拍长音', focus:'小音量保持清楚音高，不拖成漏气', cue:'wu 或 mum 中间元音', label:'持续4拍 → 休4拍 × 4', type:'sustain', bpm:60, beats:4, restBeats:4, rounds:4, prep:6, post:8 },
      { id:'soft-medium-soft', title:'mum · 中声 → 弱声', focus:'同一音高只缩小一点，不变成耳语', cue:'mum', label:'中声4拍 → 休2拍 → 弱声4拍', type:'dynamic', bpm:60, span:4, direction:'up', prep:6, gap:2, post:8 },
