      { id:'high-wu-12321', title:'轻 wu · 三音连接', focus:'轻、连，不在最高音突然放大', cue:'wu（轻“呜”）', label:'1–2–3–2–1', type:'scale', pattern:[0,2,4,2,0], bpm:60, span:5, direction:'updown', prep:6, gap:2, response:3, post:6, demo:true },
